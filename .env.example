# Google Gemini API Key (optional for cloud evaluation)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional for cloud evaluation)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (optional for cloud evaluation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama Base URL (optional for local evaluation, default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
